# ==============================================================================
# Table Flow - Environment Configuration Example
# Copy this file to .env.local and populate the values for your Supabase project.
# Do NOT commit .env.local to version control!
# ==============================================================================

# Supabase Project Connection (Region: ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret Key for Table QR Code HMAC-SHA256 Token Signing
TABLE_QR_SECRET=

# Demo Staff Account Seed Password
DEMO_STAFF_PASSWORD=
