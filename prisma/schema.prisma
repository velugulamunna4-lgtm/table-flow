// ==============================================================================
// Table Flow: Prisma Schema
// PostgreSQL Relational Database Schema with full indices and constraints
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                String            @id @default(uuid()) @db.Uuid
  slug              String            @unique
  name              String
  logoUrl           String?           @map("logo_url")
  currency          String            @default("INR")
  gstRate           Decimal           @default(5.00) @map("gst_rate") @db.Decimal(5, 2)
  serviceChargeRate Decimal           @default(0.00) @map("service_charge_rate") @db.Decimal(5, 2)
  theme             String            @default("sunny-family")
  hours             Json?             @default("{\"open\": \"11:00 AM\", \"close\": \"11:00 PM\"}")
  address           String?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  profiles          Profile[]
  tables            Table[]
  categories        MenuCategory[]
  menuItems         MenuItem[]
  tableSessions     TableSession[]
  orders            Order[]
  waiterRequests    WaiterRequest[]
  reviews           Review[]
  stockItems        StockItem[]
  waterTanks        WaterTank[]
  securitySessions  SecuritySession[]

  @@map("restaurants")
}

model Profile {
  id           String     @id @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  fullName     String     @map("full_name")
  role         String     // 'owner', 'admin', 'waiter', 'kitchen'
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Table {
  id             String         @id @default(uuid()) @db.Uuid
  restaurantId   String         @map("restaurant_id") @db.Uuid
  tableNumber    Int            @map("table_number")
  capacity       Int            @default(4)
  qrToken        String?        @unique @map("qr_token")
  tokenExpiresAt DateTime?      @map("token_expires_at") @db.Timestamptz(6)
  status         String         @default("free") // 'free', 'occupied', 'needs_help', 'bill_pending', 'clean_table'
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions       TableSession[]
  orders         Order[]
  waiterRequests WaiterRequest[]
  securitySessions SecuritySession[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@map("tables")
}

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  name         String
  icon         String?
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id                      String        @id @default(uuid()) @db.Uuid
  restaurantId            String        @map("restaurant_id") @db.Uuid
  categoryId              String?       @map("category_id") @db.Uuid
  name                    String
  nameTranslations        Json?         @default("{}") @map("name_translations")
  description             String?
  descriptionTranslations Json?         @default("{}") @map("description_translations")
  price                   Decimal       @db.Decimal(10, 2)
  costPrice               Decimal?      @map("cost_price") @db.Decimal(10, 2)
  isVeg                   Boolean       @default(true) @map("is_veg")
  spiceLevel              Int           @default(0) @map("spice_level")
  imageUrl                String?       @map("image_url")
  emojiFallback           String?       @map("emoji_fallback")
  isSpecial               Boolean       @default(false) @map("is_special")
  isAvailable             Boolean       @default(true) @map("is_available")
  preparationTimeMinutes  Int?          @default(15) @map("preparation_time_minutes")
  station                 String?
  calories                Int?
  tags                    Json?         @default("[]")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant              Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category                MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems              OrderItem[]

  @@index([restaurantId, categoryId])
  @@map("menu_items")
}

model TableSession {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  tableId      String     @map("table_id") @db.Uuid
  startedAt    DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime?  @map("ended_at") @db.Timestamptz(6)
  status       String     @default("open") // 'open', 'closed'
  guestCount   Int        @default(1) @map("guest_count")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders       Order[]
  bill         Bill?

  @@index([restaurantId, tableId])
  @@map("table_sessions")
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  tableSessionId String?       @map("table_session_id") @db.Uuid
  tableId        String        @map("table_id") @db.Uuid
  orderNumber    String        @map("order_number")
  status         String        @default("sent") // 'sent', 'accepted', 'cooking', 'ready', 'served', 'cancelled'
  source         String        @default("customer") // 'customer', 'waiter'
  notes          String?
  subtotal       Decimal?      @default(0.00) @db.Decimal(10, 2)
  tax            Decimal?      @default(0.00) @db.Decimal(10, 2)
  total          Decimal?      @default(0.00) @db.Decimal(10, 2)
  paymentStatus  String?       @default("pending") @map("payment_status")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptedAt     DateTime?     @map("accepted_at") @db.Timestamptz(6)
  readyAt        DateTime?     @map("ready_at") @db.Timestamptz(6)

  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  session        TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  table          Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items          OrderItem[]

  @@index([restaurantId, status])
  @@index([tableSessionId])
  @@map("orders")
}

model OrderItem {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  menuItemId      String?   @map("menu_item_id") @db.Uuid
  nameSnapshot    String    @map("name_snapshot")
  unitPrice       Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity        Int
  notes           String?
  itemStatus      String    @default("pending") @map("item_status") // 'pending', 'accepted', 'rejected', 'cooking', 'ready'
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Bill {
  id                  String        @id @default(uuid()) @db.Uuid
  tableSessionId      String        @unique @map("table_session_id") @db.Uuid
  subtotal            Decimal       @db.Decimal(10, 2)
  gstAmount           Decimal       @map("gst_amount") @db.Decimal(10, 2)
  serviceChargeAmount Decimal       @default(0.00) @map("service_charge_amount") @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  status              String        @default("open") // 'open', 'paid'
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(6)

  session             TableSession  @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  payments            Payment[]
  splits              BillSplit[]

  @@map("bills")
}

model Payment {
  id                String      @id @default(uuid()) @db.Uuid
  billId            String      @map("bill_id") @db.Uuid
  amount            Decimal     @db.Decimal(10, 2)
  method            String      // 'upi', 'card', 'wallet', 'cash', 'counter'
  providerOrderId   String?     @map("provider_order_id")
  providerPaymentId String?     @map("provider_payment_id")
  status            String      @default("created") // 'created', 'captured', 'failed'
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  bill              Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  splits            BillSplit[]

  @@map("payments")
}

model BillSplit {
  id        String   @id @default(uuid()) @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  label     String
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("unpaid") // 'unpaid', 'paid'
  paymentId String?  @map("payment_id") @db.Uuid

  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("bill_splits")
}

model WaiterRequest {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  tableId      String    @map("table_id") @db.Uuid
  type         String    // 'water', 'bill', 'help', 'clean_table', 'call_waiter'
  details      String?
  status       String    @default("open") // 'open', 'resolved'
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@map("waiter_requests")
}

model Review {
  id              String     @id @default(uuid()) @db.Uuid
  restaurantId    String     @map("restaurant_id") @db.Uuid
  orderId         String?    @map("order_id") @db.Uuid
  tableNumber     Int        @map("table_number")
  foodRating      Int        @map("food_rating")
  serviceRating   Int        @map("service_rating")
  ambianceRating  Int        @map("ambiance_rating")
  overallRating   Int        @map("overall_rating")
  comment         String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("reviews")
}

model StockItem {
  id            String     @id @default(uuid()) @db.Uuid
  restaurantId  String     @map("restaurant_id") @db.Uuid
  name          String
  category      String
  currentQty    Decimal    @map("current_qty") @db.Decimal(10, 2)
  minThreshold  Decimal    @map("min_threshold") @db.Decimal(10, 2)
  unit          String
  status        String     @default("in_stock") // 'in_stock', 'low_stock', 'critical'
  lastRestocked DateTime   @default(now()) @map("last_restocked") @db.Timestamptz(6)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("stock_items")
}

model WaterTank {
  id                 String     @id @default(uuid()) @db.Uuid
  restaurantId       String     @map("restaurant_id") @db.Uuid
  tankName           String     @map("tank_name")
  capacityLiters     Decimal    @map("capacity_liters") @db.Decimal(10, 2)
  currentLevelLiters Decimal    @map("current_level_liters") @db.Decimal(10, 2)
  levelPercentage    Int        @map("level_percentage")
  status             String     @default("normal") // 'normal', 'low', 'refilling'
  lastChecked        DateTime   @default(now()) @map("last_checked") @db.Timestamptz(6)

  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("water_tanks")
}

model SecuritySession {
  id                String     @id @default(uuid()) @db.Uuid
  restaurantId      String     @map("restaurant_id") @db.Uuid
  tableId           String     @map("table_id") @db.Uuid
  currentSessionId  String     @map("current_session_id")
  deviceFingerprint String     @map("device_fingerprint")
  isActive          Boolean    @default(true) @map("is_active")
  odgBlocked        Boolean    @default(false) @map("odg_blocked")
  attemptsCount     Int        @default(0) @map("attempts_count")
  lastActive        DateTime   @default(now()) @map("last_active") @db.Timestamptz(6)

  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table             Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, tableId])
  @@map("security_sessions")
}
